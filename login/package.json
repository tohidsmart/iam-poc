{
    "name": "login-consent",
    "version": "0.1.0",
    "private": true,
    "description": "Login and consent app for Ory Hydra",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "dev": "tsx watch src/main.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . && tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/csrf-protection": "^8.0.1",
        "@fastify/formbody": "^9.0.0",
        "@fastify/helmet": "^13.1.1",
        "@fastify/rate-limit": "^11.2.0",
        "argon2": "^0.45.1",
        "eta": "^4.6.0",
        "fastify": "^5.12.5",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.12.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    }
}
